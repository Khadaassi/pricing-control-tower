ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
BACKEND_API_BASE_URL=http://localhost:8000

APP_NAME="Pricing Control Tower AI Service"
APP_VERSION="0.1.0"
ENVIRONMENT="local"

LLM_PROVIDER="groq"
LLM_MODEL="llama-3.1-8b-instant"
GROQ_API_KEY="your-groq-api-key"

BACKEND_API_URL="http://localhost:8000"

# RAG — embedding provider (local: Ollama, Docker: http://host.docker.internal:11434)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL_NAME=mxbai-embed-large
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_TIMEOUT_SECONDS=30

# RAG — vector store (local: localhost:8010, Docker service: http://chromadb:8000)
CHROMADB_URL=http://localhost:8010
RAG_COLLECTION_NAME=pricing_control_tower_docs
RAG_TOP_K=5