# Read by docker-compose.yml for variable substitution (docker compose up).
# Copy to .env and fill in real values — never commit the filled-in file.

# Shared HMAC secret used to sign/verify internal service tokens between
# frontend, ai_service, and backend. Must be identical across all three
# services. Generate your own with: python3 -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_AUTH_SECRET=

# Django secret key (frontend), used to sign sessions and CSRF tokens.
# Generate one with:
# python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False

# Set to True only once a TLS-terminating reverse proxy/load balancer sits in front of this
# stack (docker-compose itself serves plain HTTP). Enables SESSION_COOKIE_SECURE,
# CSRF_COOKIE_SECURE, and SECURE_SSL_REDIRECT. Flipping this on without real HTTPS in front
# breaks logins (secure cookies never sent back) and causes an infinite redirect loop.
DJANGO_HTTPS_ENABLED=False

# Grafana admin credentials. No default — pick a real password, not "admin".
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Postgres credentials. Must match POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB
# in backend/.env — that file seeds the postgres container on first init;
# this one is only used by docker-compose.yml to build the backend's
# in-container DATABASE_URL. Changing the password here does NOT rotate it on
# an already-initialized postgres volume (only applies on a fresh volume).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
