# Read by docker-compose.yml for variable substitution (docker compose up).
# Copy to .env and fill in real values — never commit the filled-in file.

# Shared HMAC secret used to sign/verify internal service tokens between
# frontend, ai_service, and backend. Must be identical across all three
# services. Generate your own with: python3 -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_AUTH_SECRET=

# Django secret key (frontend), used to sign sessions and CSRF tokens.
# Generate one with:
# python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False

# Grafana admin credentials. No default — pick a real password, not "admin".
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
