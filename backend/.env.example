# Copy to .env and fill in real values — never commit the filled-in file.
# Used both by docker-compose.yml (to seed the postgres container and build
# DATABASE_URL) and when running the backend directly on the host.

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Only used when running the backend directly on the host — docker-compose.yml
# overrides this with a container-network URL (postgres:5432) at runtime.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/DB_NAME

# Shared HMAC secret used to sign/verify internal service tokens between
# backend, frontend, and ai_service. Must be identical across all three.
# Generate your own with: python3 -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_AUTH_SECRET=
