FASTAPI_BASE_URL=http://127.0.0.1:8000
AI_SERVICE_BASE_URL=http://localhost:8001

# Shared HMAC secret used to sign internal service tokens sent to the backend
# in place of a raw user email. Must match backend's and ai_service's value.
INTERNAL_AUTH_SECRET=

# Django secret key, used to sign sessions and CSRF tokens. Generate one with:
# python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# Never "True" outside local development — DEBUG pages leak settings and source.
DJANGO_DEBUG=False
# Set to True only once this deployment sits behind HTTPS (reverse proxy/load balancer with
# TLS termination). Enables SESSION_COOKIE_SECURE, CSRF_COOKIE_SECURE, SECURE_SSL_REDIRECT.
DJANGO_HTTPS_ENABLED=False
